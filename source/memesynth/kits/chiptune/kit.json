{
  "name": "芯片音乐 NES 2A03",
  "_note": "由 tools/make_kits.py chiptune 生成，可随时重跑覆盖。rootHz 是生成时的已知值，不必再测。",
  "samples": {
    "pulse12": {
      "file": "samples/pulse12.wav",
      "rootHz": 220.0,
      "_label": "脉冲波 12.5% · 细而尖"
    },
    "pulse25": {
      "file": "samples/pulse25.wav",
      "rootHz": 220.0,
      "_label": "脉冲波 25% · 经典主音"
    },
    "pulse50": {
      "file": "samples/pulse50.wav",
      "rootHz": 220.0,
      "_label": "方波 50% · 最饱满"
    },
    "tri_bass": {
      "file": "samples/tri_bass.wav",
      "rootHz": 110.0,
      "_label": "三角波贝斯"
    },
    "noise_kick": {
      "file": "samples/noise_kick.wav",
      "rootHz": 55.0,
      "_label": "扫频底鼓"
    },
    "noise_snare": {
      "file": "samples/noise_snare.wav",
      "rootHz": 1000.0,
      "_label": "噪声军鼓"
    },
    "noise_hat": {
      "file": "samples/noise_hat.wav",
      "rootHz": 8000.0,
      "_label": "噪声闭镲"
    },
    "noise_open": {
      "file": "samples/noise_open.wav",
      "rootHz": 8000.0,
      "_label": "噪声开镲"
    },
    "noise_crash": {
      "file": "samples/noise_crash.wav",
      "rootHz": 6000.0,
      "_label": "噪声吊镲"
    },
    "chip_tom": {
      "file": "samples/chip_tom.wav",
      "rootHz": 240.0,
      "_label": "扫频嗵鼓"
    }
  },
  "voices": {
    "bass": {
      "sample": "tri_bass",
      "gain": 1.0,
      "follow": "note",
      "fade": 0.002
    },
    "guitar": {
      "sample": "pulse12",
      "gain": 0.5,
      "pan": 0.3,
      "follow": "note",
      "fade": 0.002
    },
    "guitar/distorted electric guitar": {
      "sample": "pulse25",
      "gain": 0.55,
      "pan": -0.3,
      "follow": "note",
      "fade": 0.002
    },
    "piano": {
      "sample": "pulse50",
      "gain": 0.5,
      "pan": -0.15,
      "follow": "note",
      "fade": 0.002
    },
    "strings": {
      "sample": "pulse50",
      "transpose": 12,
      "gain": 0.32,
      "pan": 0.18,
      "follow": "note",
      "fade": 0.002
    },
    "vocals": {
      "sample": "pulse25",
      "gain": 1.0,
      "pan": 0.0,
      "follow": "note",
      "fade": 0.002
    },
    "drums/kick": {
      "sample": "noise_kick",
      "pitched": false,
      "follow": "sample",
      "gain": 1.4
    },
    "drums/snare": {
      "sample": "noise_snare",
      "pitched": false,
      "follow": "sample",
      "gain": 1.6
    },
    "drums/hihat": {
      "sample": "noise_hat",
      "pitched": false,
      "follow": "sample",
      "gain": 2.2,
      "pan": 0.2
    },
    "drums/openhat": {
      "sample": "noise_open",
      "pitched": false,
      "follow": "sample",
      "gain": 1.5,
      "pan": 0.2
    },
    "drums/tom": {
      "sample": "chip_tom",
      "pitched": false,
      "follow": "sample",
      "gain": 1.3
    },
    "drums/crash": {
      "sample": "noise_crash",
      "pitched": false,
      "follow": "sample",
      "gain": 0.9,
      "pan": -0.4
    },
    "drums/ride": {
      "sample": "noise_open",
      "pitched": false,
      "follow": "sample",
      "maxDur": 0.12,
      "gain": 1.4,
      "pan": 0.45
    }
  }
}