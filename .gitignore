# Source-only repository. Local music, weights, runtimes and releases stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/SOURCE_OF_TRUTH.md
!/DEVELOPMENT_LOG.md
!/CLAUDE_HANDOFF.md
!/AGENTS.md
!/CLAUDE.md
!/docs/
!/source/
!/work/
!/artifacts/

# Curated historical text and small verification summaries only.
/work/*
!/work/*/
/work/*/*
!/work/*/*.md
/artifacts/*
!/artifacts/*/
/artifacts/*/*
!/artifacts/*/published.json
!/artifacts/*/regression.json
!/artifacts/*/verification.json

# Generated / installed dependencies and local files at any depth.
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.cache/
**/.DS_Store
**/Thumbs.db
**/desktop-build/
/source/glitch-generator-typescript/artifacts/
*.pyc
*.pyo
*.log
*.lnk
*.tmp
*.bak
*.zip
*.7z
*.exe
*.dll
*.msi

# Model payloads and music are obtained / generated outside Git.
*.pth
*.pt
*.ckpt
*.onnx
*.safetensors
*.h5
*.hdf5
*.wav
*.flac
*.mp3
*.ogg
*.m4a
*.aiff
*.mid
*.midi
*.sf2
*.sf3

# Credentials and machine-specific configuration; examples remain trackable.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
**/auth.json
**/credentials.json
**/.npmrc
**/runtime.local.json
**/development-settings.json
